# Application
NODE_ENV=development
PORT=4000
APP_NAME=MSK Backend
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
APP_MOBILE_DEEP_LINK=msk://

# Database
DATABASE_URL=postgresql://msk:msk@localhost:5432/msk?schema=public

# JWT
JWT_ACCESS_SECRET=replace-with-strong-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret
JWT_REFRESH_TTL=30d

# OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# Redis (sessions, cache, queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Object storage (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, MinIO)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=msk-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MSK <no-reply@msk.example>"

# SMS / OTP delivery (Twilio or similar)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Push notifications (Expo / FCM)
EXPO_ACCESS_TOKEN=
FCM_SERVER_KEY=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
