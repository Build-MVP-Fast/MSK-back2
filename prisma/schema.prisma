// ============================================================================
//  MSK Platform — Prisma Schema
// ----------------------------------------------------------------------------
//  Single source of truth for the unified backend that powers:
//    1. Mobile app (msk)        — guests, receptionists, admins, super-users
//    2. Website (msk-web)       — public marketing + booking + careers
//    3. Admin dashboard         — property/room/booking management
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // `native`            — for local dev (your machine's OS).
  // `linux-musl-openssl-3.0.x` — for Alpine-based Docker images on
  //   Render/Fly/etc. Modern Alpine ships OpenSSL 3.x; the default
  //   `linux-musl` variant looks for libssl 1.1 which Alpine no longer
  //   has, hence the runtime crash.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
//  ENUMS
// ============================================================================

// 4 roles cover everything in the current product:
//   WEB_GUEST    — public-website customers (book, view profile)
//   RECEPTIONIST — front-desk: bookings, calendar, view applications
//   ADMIN        — operational admin: everything ops + content
//   SUPER_USER   — owner: ADMIN powers + hard-deletes + master config
// GUEST / STAFF / SUPPLIER were dropped as they were never used in the
// admin or website flow.
enum UserRole {
  WEB_GUEST
  RECEPTIONIST
  ADMIN
  SUPER_USER
}

